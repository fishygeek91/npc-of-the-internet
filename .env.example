# NPC of the Internet — environment variables (names only; see ops/SECRETS.md)
# Copy to .env and fill in values. Never commit .env.

# Recommended: OpenAI-compat (OpenRouter). Unset NPC_BRAIN_PROVIDER still selects Anthropic.
NPC_BRAIN_PROVIDER=openai-compat
NPC_BRAIN_BASE_URL=https://openrouter.ai/api/v1
NPC_BRAIN_API_KEY=
# Example model slug (2026-07-28) — confirm against the provider catalog.
NPC_BRAIN_MODEL=deepseek/deepseek-v4-flash
NPC_BRAIN_MAX_TOKENS=1024
NPC_BRAIN_TIMEOUT_MS=60000
NPC_BRAIN_PROVIDER_ALLOWLIST=fireworks,together,deepinfra
# Anthropic alternative:
# NPC_BRAIN_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# NPC_BRAIN_MODEL=claude-sonnet-4-20250514
# LIVE_TESTS=            # set to 1 to enable live API tests (uses real key, costs money)

# Discord Door (@npc/door-discord) — names only; see ops/SECRETS.md
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_CHANNEL_ID=
# DISCORD_OPERATOR_IDS=
# DOOR_KEY_PATH=
# SOUL_PUBLIC_KEY=
# SOUL_KEY_PATH=          # manual-residency harness
# SOULCHAIN_DIR=./soulchain-data-manual
# DISCORD_REVIEW_TIMEOUT_MS=300000
# DOOR_HTTP_HOST=127.0.0.1
# DOOR_HTTP_PORT=9090

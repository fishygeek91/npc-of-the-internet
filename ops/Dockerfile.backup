# Backup sidecar: watches soulchain volume and syncs to rclone remote.
# Build context: repo root (see ops/compose.ghost.yml backup service).
# syntax=docker/dockerfile:1

FROM alpine:3.21

# `apk upgrade` applies Alpine security fixes published after the base image was
# built; a stale base layer otherwise fails the release Trivy gate (v0.4.0:
# libssl3/libcrypto3 CVE-2026-75804 + CVE-2026-84782, fixed in 3.3.7-r2).
# Container uid/gid pinned to 10001 so host bind-mounted keys/rclone owned 10001:10001 are readable on Linux VPS (#84). macOS Docker Desktop remaps ownership and hides the bug.
RUN apk upgrade --no-cache \
  && apk add --no-cache bash inotify-tools rclone \
  && addgroup -g 10001 npc \
  && adduser -u 10001 -G npc -S -h /home/npc npc

COPY ops/scripts/backup-watch.sh /usr/local/bin/backup-watch.sh
RUN chmod +x /usr/local/bin/backup-watch.sh

ENV BACKUP_SOURCE_DIR=/data/soulchain \
    BACKUP_DEBOUNCE_SEC=30 \
    BACKUP_INTERVAL_SEC=300 \
    BACKUP_VERIFY_SEC=86400 \
    BACKUP_RETRY_SEC=900 \
    BACKUP_HEARTBEAT_DEFER_SEC=3600 \
    BACKUP_HISTORY_SEC=86400

USER npc

ENTRYPOINT ["/usr/local/bin/backup-watch.sh"]

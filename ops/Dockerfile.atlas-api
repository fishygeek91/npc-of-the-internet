# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS build

RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/atlas/package.json packages/atlas/
COPY packages/atlas-site/package.json packages/atlas-site/
COPY packages/door-discord/package.json packages/door-discord/
COPY packages/door-sdk/package.json packages/door-sdk/
COPY packages/immune/package.json packages/immune/
COPY packages/osp-cli/package.json packages/osp-cli/
COPY packages/osp-core/package.json packages/osp-core/
COPY packages/runtime/package.json packages/runtime/

RUN pnpm install --frozen-lockfile

COPY packages/osp-core packages/osp-core
COPY packages/atlas packages/atlas

RUN pnpm --filter @npc/atlas... build
RUN pnpm --filter @npc/atlas deploy --prod /out

FROM node:22-slim AS runtime

# Container uid/gid pinned to 10001 so host bind-mounted keys/rclone owned 10001:10001 are readable on Linux VPS (#84). macOS Docker Desktop remaps ownership and hides the bug.
RUN groupadd --gid 10001 npc && useradd --uid 10001 --gid npc --create-home --home-dir /home/npc npc

# Strip unused Node base-image package managers from the runtime image (#130).
# Images only execute `node dist/...`; bundled npm/corepack is unused Trivy surface.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

COPY --from=build /out /app

WORKDIR /app
USER npc

# pnpm deploy does not emit a .bin shim for this package's own `bin` entry —
# invoke the built entrypoint directly (package.json `bin.atlas-api` remains
# for local/dev installs).
CMD ["node", "dist/server.js"]

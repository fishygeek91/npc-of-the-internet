# Ghost compose — names-only placeholders. Copy to ops/.env and replace before deploy.
# Validate: docker compose --env-file ops/.env.example -f ops/compose.ghost.yml config

NPC_IMAGE_TAG=latest

# Host paths (never commit real key files or rclone secrets)
# On Linux, keys/ and rclone/ on the host must be owned by 10001:10001
# (container user npc) with dirs 0700 and key/conf files 0600 — see issue #84
# and ops/SECRETS.md (NPC_CONTAINER_UID / NPC_CONTAINER_GID).
SOUL_KEY_HOST_PATH=/tmp/npc-ghost/keys/soul.key
DOOR_KEY_HOST_PATH=/tmp/npc-ghost/keys/door.key
RCLONE_CONFIG_HOST_PATH=/tmp/npc-ghost/rclone

# Runtime / Brain (ops/SECRETS.md)
# Exactly one of ANTHROPIC_API_KEY or ANTHROPIC_API_KEY_FILE (path inside container).
# When using *_FILE, comment out the direct var (do not leave replace-me set).
ANTHROPIC_API_KEY=replace-me
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
# ANTHROPIC_API_KEY_HOST_PATH=/var/lib/npc-ghost/secrets/anthropic_api_key
NPC_BRAIN_MODEL=claude-sonnet-4-20250514
NPC_BRAIN_MAX_TOKENS=1024
NPC_BRAIN_TIMEOUT_MS=60000

# door-discord (packages/door-discord/src/config.ts)
# CURRENT_DOOR_ID for runtime is derived in compose as discord:${DISCORD_GUILD_ID} — no need to set it in .env unless overriding.
# Exactly one of DISCORD_BOT_TOKEN or DISCORD_BOT_TOKEN_FILE.
# When using *_FILE, comment out the direct var (do not leave replace-me set).
DISCORD_BOT_TOKEN=replace-me
# DISCORD_BOT_TOKEN_FILE=/run/secrets/discord_bot_token
# DISCORD_BOT_TOKEN_HOST_PATH=/var/lib/npc-ghost/secrets/discord_bot_token
DISCORD_GUILD_ID=1000000000000000001
DISCORD_CHANNEL_ID=1000000000000000002
DISCORD_OPERATOR_IDS=1000000000000000004
DISCORD_REVIEW_TIMEOUT_MS=300000
DISCORD_REVIEW_CHANNEL_ID=
DISCORD_USER_RATE_PER_MIN=20
DISCORD_USER_BURST=5
DISCORD_CHANNEL_RATE_PER_MIN=60
DISCORD_CHANNEL_BURST=15
DISCORD_COMMUNITY_NAME=Discord Door
DISCORD_COMMUNITY_DESCRIPTION=A Discord channel hosting the Wanderer.
# TEST-ONLY fill-byte soul public key (see packages/atlas/test/helpers/fixed-keys.ts)
SOUL_PUBLIC_KEY=6kpsY-KcUgq-9VB7Ey7F-ZVHdq6-vnuSQh7qaRRG0iw

# atlas-api (packages/atlas/src/config.ts)
# TEST-ONLY fill-byte door public key (see packages/atlas/test/helpers/fixed-keys.ts); must match CURRENT_DOOR_ID
ATLAS_DOOR_PUBKEYS=discord:1000000000000000001=E5j2LG0aRXxRumpLXz29L2n8qTIWIY3ImX5Ba9F9k8o

# backup sidecar (ops/scripts/backup-watch.sh)
BACKUP_RCLONE_REMOTE=ghost-remote:npc/soulchain
BACKUP_DEBOUNCE_SEC=5
BACKUP_INTERVAL_SEC=300
# ALLOW_CHAIN_SHRINK=

# Encrypted key backup (#72) — host-only; never the backup sidecar; never BACKUP_RCLONE_REMOTE.
# AGE_RECIPIENT=age1replace-me
# AGE_IDENTITY_PATH=/var/lib/npc-ghost/keys/age-identity.txt
# KEY_BACKUP_RCLONE_REMOTE=ghost-keys:npc/keys
# Optional separate rclone.conf (different B2 app key) for key backup:
# KEY_BACKUP_RCLONE_CONFIG=/var/lib/npc-ghost/rclone-keys/rclone.conf

# IPFS dual-write + replication (disabled by default — do not set NPC_REPLICATION_ENABLED=1 until Gate 2)
# NPC_SOULCHAIN_IPFS_DIR=/data/soulchain-ipfs
# NPC_PUBLISHED_CAR_PATH=/data/published/soulchain-latest.car
# NPC_MANIFEST_CID_PATH=/data/published/manifest-cid.txt
# NPC_REPLICATION_ENABLED=0
# NPC_REPLICATION_TARGETS=[]
# NPC_REPLICATION_DRAIN_INTERVAL_MS=15000
# STORACHA_TOKEN=replace-me
# FILEBASE_TOKEN=replace-me

{
  "name": "@npc/osp-core",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.types.json --noEmit",
    "generate:schema": "tsx scripts/generate-json-schema.ts && prettier --write ../../spec/osp/schema/*.json",
    "generate:vectors": "tsx scripts/generate-vectors.ts && prettier --write ../../spec/osp/vectors/*.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ipld/car": "^5.4.7",
    "@ipld/dag-json": "^11.0.1",
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.7.1",
    "blockstore-fs": "^4.0.1",
    "interface-blockstore": "^7.0.1",
    "multiformats": "^14.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19.4",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}

{
  "name": "@npc/osp-core",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.types.json --noEmit",
    "generate:schema": "tsx scripts/generate-json-schema.ts && prettier --write ../../spec/osp/schema/*.json",
    "generate:vectors": "tsx scripts/generate-vectors.ts && prettier --write ../../spec/osp/vectors/*.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ipld/car": "^5.4.7",
    "@ipld/dag-json": "^11.0.1",
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^2.3.0",
    "blockstore-fs": "^4.0.1",
    "interface-blockstore": "^7.0.1",
    "multiformats": "^14.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26",
    "fast-check": "^4.10.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}

{
  "name": "npc-of-the-internet",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "fast-uri": ">=4.2.3",
      "undici@6": "^6.29.1",
      "undici@8": "^8.12.2",
      "source-map-js": ">=1.2.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-fc5q-39xc-vjpf"
      ]
    }
  },
  "scripts": {
    "changeset": "changeset",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "pnpm -r test",
    "check": "pnpm build && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
